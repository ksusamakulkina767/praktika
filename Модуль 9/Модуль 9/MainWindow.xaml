<Window x:Class="StudentManagerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление списком студентов" Height="600" Width="950"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: Форма ввода -->
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="15"/>
            <!-- Правая колонка: Таблица и фильтры -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (Форма ввода) -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Данные студента" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>

                <TextBlock Text="ФИО:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtFullName" Padding="10" Margin="0,0,0,10"/>

                <TextBlock Text="Возраст:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtAge" Padding="10" Margin="0,0,0,10"/>

                <TextBlock Text="Группа:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtGroup" Padding="10" Margin="0,0,0,10"/>

                <TextBlock Text="Средний балл:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtGpa" Padding="10" Margin="0,0,0,15"/>

                <Button x:Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" Height="35" Background="#0078D4" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>
                <Button x:Name="BtnClear" Content="Очистить форму" Click="BtnClear_Click" Height="28" Background="#E0E0E0" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Правая панель (Таблица и фильтрация) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поиск и сортировка -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="TxtSearch" Width="230" Padding="6" TextChanged="TxtSearch_TextChanged" Margin="0,0,10,0"/>

                <ComboBox x:Name="CmbSort" Width="200" Padding="6" SelectionChanged="CmbSort_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Сортировка: По умолчанию"/>
                    <ComboBoxItem Content="По имени (А-Я)"/>
                    <ComboBoxItem Content="По возрасту"/>
                    <ComboBoxItem Content="По среднему баллу (убыв.)"/>
                </ComboBox>
            </StackPanel>

            <!-- Таблица -->
            <DataGrid x:Name="DgStudents" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionChanged="DgStudents_SelectionChanged"
                      Background="White" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="70"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="95"/>
                    <DataGridTextColumn Header="Ср. балл" Binding="{Binding Gpa, StringFormat=\{0:F2\}}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Кнопка удаления -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Удалить выбранного студента" Click="BtnDelete_Click" Padding="12,6" Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>