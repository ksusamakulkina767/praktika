<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами и задачами" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: Формы добавления -->
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="15"/>
            <!-- Правая колонка: Таблицы данных -->
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Форма добавления задачи/проекта -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Управление задачей" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>

                <TextBlock Text="Проект:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbProjects" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="Сотрудник (Исполнитель):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbEmployees" DisplayMemberPath="FullName" SelectedValuePath="Id" Padding="6" Margin="0,0,0,10"/>

                <TextBlock Text="Название задачи:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtTitle" Padding="8" Margin="0,0,0,10"/>

                <TextBlock Text="Статус:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbStatus" Padding="6" Margin="0,0,0,10" SelectedIndex="0">
                    <ComboBoxItem Content="К выполнению"/>
                    <ComboBoxItem Content="В процессе"/>
                    <ComboBoxItem Content="Готово"/>
                </ComboBox>

                <TextBlock Text="Приоритет:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbPriority" Padding="6" Margin="0,0,0,15" SelectedIndex="0">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <Button x:Name="BtnSaveTask" Content="Сохранить задачу" Click="BtnSaveTask_Click" Height="35" Background="#0078D4" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>
                <Button x:Name="BtnClear" Content="Очистить форму" Click="BtnClear_Click" Height="28" Background="#E0E0E0" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Правая панель: Таблицы и отчетность -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Панель управления и фильтров -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Управление проектами" Click="BtnManageProjects_Click" Padding="10,6" Margin="0,0,10,0" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Управление сотрудниками" Click="BtnManageEmployees_Click" Padding="10,6" Margin="0,0,10,0" Background="#17A2B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Таблица задач -->
            <DataGrid x:Name="DgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionChanged="DgTasks_SelectionChanged"
                      Background="White" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Название задачи" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Проект ID" Binding="{Binding ProjectId}" Width="75"/>
                    <DataGridTextColumn Header="Сотрудник ID" Binding="{Binding AssigneeId}" Width="90"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Нижняя панель с кнопкой удаления -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Удалить выбранную задачу" Click="BtnDeleteTask_Click" Padding="12,6" Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>