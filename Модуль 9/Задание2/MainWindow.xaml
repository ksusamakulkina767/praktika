<Window x:Class="ProjectManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами и задачами" Height="550" Width="800" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">

        <!-- Блок добавления проекта -->
        <GroupBox Header="Новый проект" Margin="0,0,0,10" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ProjectNameTextBox" Width="300" Height="25" Margin="0,0,10,0" ToolTip="Название проекта"/>
                <Button Content="Добавить проект" Width="120" Height="25" Click="AddProject_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Блок добавления задачи -->
        <GroupBox Header="Новая задача" Margin="0,0,0,10" Padding="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBox x:Name="TaskTitleTextBox" Width="250" Height="25" Margin="0,0,10,0" ToolTip="Название задачи"/>
                    <ComboBox x:Name="ProjectsComboBox" Width="180" Height="25" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="ProjectID" ToolTip="Выберите проект"/>
                </StackPanel>
                <Button Content="Добавить задачу" Width="140" Height="25" Click="AddTask_Click" HorizontalAlignment="Left"/>
            </StackPanel>
        </GroupBox>

        <!-- Таблицы -->
        <TextBlock Text="Список проектов:" FontWeight="Bold" Margin="0,0,0,3"/>
        <DataGrid x:Name="ProjectsDataGrid" Height="110" IsReadOnly="True" Margin="0,0,0,10"/>

        <TextBlock Text="Список задач:" FontWeight="Bold" Margin="0,0,0,3"/>
        <DataGrid x:Name="TasksDataGrid" Height="120" IsReadOnly="True" Margin="0,0,0,10"/>

        <!-- Кнопки управления -->
        <StackPanel Orientation="Horizontal">
            <Button Content="Завершить задачу" Width="140" Height="30" Click="CompleteTask_Click" Margin="0,0,10,0"/>
            <Button Content="Отчет по проектам" Width="140" Height="30" Click="ShowReport_Click"/>
        </StackPanel>

    </StackPanel>
</Window>