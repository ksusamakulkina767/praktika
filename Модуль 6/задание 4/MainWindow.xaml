<Window x:Class="задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:задание_4"
        mc:Ignorable="d"
        Title="Учет финансов (Доходы и Расходы)" Height="500" Width="850">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Таблица операций -->
        <DataGrid x:Name="FinanceDataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionChanged="FinanceDataGrid_SelectionChanged"
                  Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель управления -->
        <StackPanel Grid.Column="1" Background="#F9F9F9">
            <TextBlock Text="Управление финансами" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Тип операции:"/>
            <ComboBox x:Name="TypeComboBox" Margin="0,0,0,10" Height="25">
                <ComboBoxItem Content="Расход" IsSelected="True"/>
                <ComboBoxItem Content="Доход"/>
            </ComboBox>

            <TextBlock Text="Категория:"/>
            <TextBox x:Name="CategoryTextBox" Margin="0,0,0,10" Height="25"/>

            <TextBlock Text="Сумма:"/>
            <TextBox x:Name="AmountTextBox" Margin="0,0,0,15" Height="25"/>

            <Button Content="Добавить запись" Click="AddButton_Click" Background="#4CAF50" Foreground="White" Height="30" Margin="0,0,0,8"/>
            <Button Content="Обновить выбранную" Click="UpdateButton_Click" Background="#2196F3" Foreground="White" Height="30" Margin="0,0,0,8"/>
            <Button Content="Удалить" Click="DeleteButton_Click" Background="#F44336" Foreground="White" Height="30"/>
        </StackPanel>
    </Grid>
</Window>