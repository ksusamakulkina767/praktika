<Window x:Class="TextEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор" Height="450" Width="800">
    <DockPanel>
        <!-- Панель инструментов сверху -->
        <ToolBar DockPanel.Dock="Top">
            <!-- Кнопки управления файлом -->
            <Button x:Name="OpenButton" Content=" Открыть" Click="OpenButton_Click"/>
            <Button x:Name="SaveButton" Content=" Сохранить" Click="SaveButton_Click"/>
            <Button x:Name="SaveAsButton" Content=" Сохранить как..." Click="SaveAsButton_Click"/>
            <Button x:Name="ClearButton" Content=" Очистить" Click="ClearButton_Click"/>

            <Separator/>

            <!-- Выбор шрифта -->
            <TextBlock Text="Шрифт:" VerticalAlignment="Center" Margin="5,0,2,0"/>
            <ComboBox x:Name="FontFamilyComboBox" Width="130" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

            <!-- Выбор размера шрифта -->
            <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="5,0,2,0"/>
            <ComboBox x:Name="FontSizeComboBox" Width="50" SelectionChanged="FontSizeComboBox_SelectionChanged">
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12" IsSelected="True"/>
                <ComboBoxItem Content="14"/>
                <ComboBoxItem Content="16"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="24"/>
                <ComboBoxItem Content="28"/>
                <ComboBoxItem Content="32"/>
            </ComboBox>

            <Separator/>

            <!-- Выбор цвета текста -->
            <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="5,0,2,0"/>
            <ComboBox x:Name="FontColorComboBox" Width="90" SelectionChanged="FontColorComboBox_SelectionChanged">
                <ComboBoxItem Content="Черный" Tag="Black" IsSelected="True"/>
                <ComboBoxItem Content="Красный" Tag="Red"/>
                <ComboBoxItem Content="Синий" Tag="Blue"/>
                <ComboBoxItem Content="Зеленый" Tag="Green"/>
                <ComboBoxItem Content="Фиолетовый" Tag="Purple"/>
                <ComboBoxItem Content="Оранжевый" Tag="Orange"/>
            </ComboBox>
        </ToolBar>

        <!-- Строка состояния снизу -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Новый документ"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatsTextBlock" Text="Слов: 0 | Символов: 0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Сам текстовый редактор -->
        <RichTextBox x:Name="EditorRichTextBox" TextChanged="EditorRichTextBox_TextChanged"/>
    </DockPanel>
</Window>